PORT=3000

# Session — generate a strong random string:
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=969ad33f61f9ffaecd9029949f3a7b0a516bc655b849cc70c1f7bb46f5b18598

# Admin account — master administrator
ADMIN_EMAIL=shadanmd566@gmail.com
ADMIN_INITIAL_PASSWORD=Shadan123@#

# Gemini AI API Key (free tier — 15 requests/min)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_KEY

# Whisper model size (base = good accuracy + fast on ARM)
# Options: tiny.en | base | small | medium (larger = more accurate, more RAM)
WHISPER_MODEL=base
