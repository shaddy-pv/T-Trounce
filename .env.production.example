# ==============================================================================
# Tarang — Production Environment Template
# Copy this to .env.production and fill in real values
# NEVER commit .env.production to git!
# ==============================================================================

# MongoDB — uses local Docker container (no changes needed)
MONGODB_URI=mongodb://trounce-mongo:27017/tarang
MONGODB_DB_NAME=tarang

# Node environment
NODE_ENV=production
PORT=3000

# Session — generate a strong random string:
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_USE_LONG_RANDOM_STRING_MIN_32_CHARS

# Admin account — master administrator
ADMIN_EMAIL=shadanmd566@gmail.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_YOUR_SECURE_PASSWORD

# Gemini AI API Key (free tier — 15 requests/min)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_KEY

# Whisper model size (base = good accuracy + fast on ARM)
# Options: tiny.en | base | small | medium (larger = more accurate, more RAM)
WHISPER_MODEL=base
