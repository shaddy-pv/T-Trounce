# Copy to .env and fill in. Never commit .env.

# Do not set NODE_ENV here. npm run dev, npm run build and npm start each set the right value.

# ---- Required in production ---------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/trounce
MONGODB_DB_NAME=trounce
# At least 32 random characters, for example: openssl rand -base64 48
SESSION_SECRET=

# ---- First-run admin account --------------------------------------------------
# Created only when the database has no users. This email is also the master
# administrator, the one account allowed to change system settings.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ---- Transcription (all optional) ---------------------------------------------
# Tried in order: sidecar, then Gemini, then OpenAI. With none available, recordings
# are still saved but have no transcript.
WHISPER_SIDECAR_URL=http://127.0.0.1:8765
# If the sidecar is reachable from the internet, set the same value on both sides.
WHISPER_SIDECAR_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---- Hosting ------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Number of reverse proxies in front of the app, used to find the real client IP for
# rate limiting. Default in production is 1 (Render, Koyeb, Fly, nginx).
# Use 0 if the app faces the internet directly, otherwise clients can spoof their IP.
# TRUSTED_PROXY_HOPS=1
# Set to false only for local load testing.
# RATE_LIMIT_ENABLED=true
# Local audio cache directory. MongoDB GridFS holds the durable copy.
# AUDIO_STORAGE_DIR=.storage/audio
